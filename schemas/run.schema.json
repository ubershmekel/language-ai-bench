{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-ai-bench.example/schemas/run.schema.json",
  "title": "Language AI Bench rollout",
  "type": "object",
  "required": ["schema_version", "benchmark_version", "task_family", "language", "typecheck_config", "repo_revision", "container_image_digest", "model", "model_settings", "scaffold", "agent_version", "pier_version", "malformed_action_count", "run_id", "seed", "order_index", "toolchain_versions", "started_at", "ended_at", "verifier_case_results", "regression_results", "calibration_ref", "usage", "cache_hit_rate", "measured_cost_usd", "rate_card", "command_counts", "feedback_to_fix_events", "patch_statistics", "terminal_stage", "root_causes", "stopped_reason", "exit_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "benchmark_version": {"type": "string"},
    "task_family": {"type": "string"},
    "language": {"enum": ["javascript", "typescript", "python", "go"]},
    "typecheck_config": {"type": "string"},
    "repo_revision": {"type": "string"},
    "container_image_digest": {"type": "string"},
    "model": {"type": "string"},
    "model_settings": {"type": "object", "required": ["reasoning_effort"]},
    "scaffold": {"type": "string"},
    "agent_version": {"type": "string"},
    "pier_version": {"type": "string"},
    "malformed_action_count": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string"},
    "seed": {"type": "integer"},
    "order_index": {"type": "integer"},
    "toolchain_versions": {"type": "object"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "verifier_case_results": {"type": "array", "items": {"type": "object", "required": ["case_id", "passed", "duration_ms"]}},
    "regression_results": {"type": "array"},
    "calibration_ref": {"type": "string"},
    "usage": {"type": "object", "required": ["input_tokens", "output_tokens", "cached_input_tokens", "max_context_occupancy", "tool_output_tokens"]},
    "cache_hit_rate": {"type": "number"},
    "measured_cost_usd": {"type": "number"},
    "rate_card": {"type": "object"},
    "command_counts": {"type": "object"},
    "feedback_to_fix_events": {"type": "array"},
    "patch_statistics": {"type": "object"},
    "terminal_stage": {"enum": ["never-ran", "failed-to-build-or-typecheck", "built-but-failed-dev-tests", "passed-dev-tests-failed-hidden", "regression-only", "budget-exhausted", "harness-error", "passed"]},
    "root_causes": {"type": "array", "items": {"type": "object", "required": ["label", "evidence_event_index"]}},
    "stopped_reason": {"type": "string"},
    "exit_status": {"type": "integer"}
  },
  "additionalProperties": true
}

